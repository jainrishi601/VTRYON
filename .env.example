# YouCam API (https://yce.makeupar.com/api-console) — Bearer key starting with sk-
YOUCAM_API_KEY=
# Anthropic — the agent runs on Claude Sonnet 5.5; without a key the deterministic fallback composer answers
ANTHROPIC_API_KEY=
# Public URL of this backend (e.g. https://elara-demo.example.com). Empty = local; user photos are sent to YouCam via its File API
PUBLIC_BASE_URL=
# 1 = never spend units, serve only cached renders
YOUCAM_DEMO_MODE=0
# 1 = fake renders (tests/evals), 0 = real
RENDER_STUB=0
# Web app origin for crew share links (e.g. https://northline.example.com). Empty = the browser's Origin/Referer
WEB_URL=
